{
  "name": "chai",
  "version": "0.1.0",
  "private": true,
  "description": "Chai — isolated AI workflow builder (not part of root Aria app)",
  "scripts": {
    "dev": "next dev -p 4321",
    "predev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev -p 4321",
    "build": "prisma generate && next build",
    "prebuild": "rm -rf .next",
    "start": "next start -p 4321",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "next": "14.2.35",
    "pptxgenjs": "^4.0.1",
    "prisma": "^5.22.0",
    "react": "^18",
    "react-dom": "^18",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
